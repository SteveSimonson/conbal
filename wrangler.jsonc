{
  "name": "conbal",
  "main": "workers/site.js",
  "compatibility_date": "2026-07-31",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "conbal.us", "zone_name": "conbal.us" }, { "pattern": "conbal.us/*", "zone_name": "conbal.us" },
    { "pattern": "www.conbal.us", "zone_name": "conbal.us" }, { "pattern": "www.conbal.us/*", "zone_name": "conbal.us" }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "conbal-db", "database_id": "11977074-ec30-4530-ba57-b90377511565" }],
  "kv_namespaces": [{ "binding": "CONBAL_KV", "id": "a0eedc89f48c4902a69386930fff6885" }],
  "observability": { "enabled": true }
}
